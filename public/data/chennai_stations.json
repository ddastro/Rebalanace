{
  "_meta": {
    "description": "Synthetic demonstration station data for the Chennai Spatial Risk Radar.",
    "disclaimer": "ALL VALUES ARE SIMULATED. Not live operator data. Not derived from the UCI Bike Sharing dataset. Locations are real Chennai-area localities; station records are fictional demonstration data.",
    "coordinate_source": "Approximate locality-centre coordinates from public geographic references. No exact street addresses implied.",
    "inventory_equations": {
      "served_pickups": "min(expected_pickups, current_inventory)",
      "unserved_pickups": "expected_pickups - served_pickups",
      "inventory_after_pickups": "current_inventory - served_pickups",
      "available_docks": "capacity - inventory_after_pickups",
      "served_returns": "min(expected_returns, available_docks)",
      "unserved_returns": "expected_returns - served_returns",
      "projected_inventory": "inventory_after_pickups + served_returns"
    },
    "risk_thresholds": {
      "NORMAL": "projected_inventory >= 20% capacity AND projected_inventory <= 80% capacity AND unserved_pickups == 0 AND unserved_returns == 0",
      "POTENTIAL_SHORTAGE": "projected_inventory > 0 AND projected_inventory < 20% capacity",
      "SEVERE_SHORTAGE": "projected_inventory == 0 OR unserved_pickups > 0",
      "POTENTIAL_DOCK_OVERFLOW": "projected_inventory > 80% capacity OR unserved_returns > 0"
    }
  },
